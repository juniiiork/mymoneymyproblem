:root {
    --preto: #000000;
    --preto-2: #0a0a0a;
    --card: #111111;
    --borda: #1f1f1f;
    --vermelho: #e10600;
    --vermelho-escuro: #8f0400;
    --texto: #f5f5f5;
    --texto-2: #a3a3a3;
    --fonte-titulo: 'Bebas Neue', Impact, sans-serif;
    --fonte-corpo: 'Inter', Arial, Helvetica, sans-serif;
}

* { box-sizing: border-box; }

html { scroll-behavior: smooth; }

body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background: var(--preto);
    color: var(--texto);
    font-family: var(--fonte-corpo);
    font-size: 16px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
}

img { display: block; max-width: 100%; height: auto; }

section[id] { scroll-margin-top: 80px; }

h1, h2, h3, .logo {
    font-family: var(--fonte-titulo);
    font-weight: 400;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin: 0;
}

/* ---------- NAVBAR ---------- */
.navbar {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--borda);
}

.navbar-inner {
    max-width: 1180px;
    margin: 0 auto;
    padding: 14px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
}

.logo {
    font-size: 26px;
    color: var(--texto);
    text-decoration: none;
    letter-spacing: 0.2em;
}

.logo:hover { color: var(--vermelho); }

.navbar ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 28px;
    flex-wrap: wrap;
}

.navbar li a {
    position: relative;
    color: var(--texto-2);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-size: 12px;
    font-weight: 500;
    transition: color 0.25s ease;
}

.navbar li a::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -6px;
    width: 0;
    height: 1px;
    background: var(--vermelho);
    transition: width 0.25s ease;
}

.navbar li a:hover,
.navbar li a.ativo { color: var(--texto); }

.navbar li a:hover::after,
.navbar li a.ativo::after { width: 100%; }

/* ---------- BOTÕES ---------- */
.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 26px;
    font-family: var(--fonte-corpo);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 2px;
    cursor: pointer;
    border: 1px solid transparent;
    transition: background-color 0.25s ease, color 0.25s ease, border-color 0.25s ease, transform 0.15s ease;
}

.btn:active { transform: translateY(1px); }

.btn-primario {
    background: var(--vermelho);
    color: #fff;
}
.btn-primario:hover { background: var(--vermelho-escuro); }

.btn-secundario {
    background: transparent;
    border-color: #2e2e2e;
    color: var(--texto);
}
.btn-secundario:hover { border-color: var(--vermelho); color: var(--vermelho); }

.btn-outline {
    background: transparent;
    border-color: var(--vermelho);
    color: var(--texto);
    width: 100%;
}
.btn-outline:hover { background: var(--vermelho); color: #fff; }

/* ---------- HERO ---------- */
.hero {
    position: relative;
    text-align: center;
    padding: 120px 24px 100px;
    background:
        radial-gradient(circle at 50% 0%, rgba(225, 6, 0, 0.18), transparent 60%),
        var(--preto);
    border-bottom: 1px solid var(--borda);
    overflow: hidden;
}

.hero-tag {
    display: inline-block;
    font-size: 11px;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--vermelho);
    border: 1px solid rgba(225, 6, 0, 0.4);
    padding: 6px 14px;
    border-radius: 999px;
    margin-bottom: 28px;
}

.hero h1 {
    font-size: clamp(64px, 16vw, 160px);
    line-height: 0.9;
    letter-spacing: 0.12em;
    margin: 0 0 18px;
}

.hero-subtitulo {
    max-width: 520px;
    margin: 0 auto 36px;
    color: var(--texto-2);
    font-size: 17px;
}

.hero-acoes {
    display: flex;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
}

/* ---------- SEÇÕES ---------- */
.secao {
    max-width: 1180px;
    width: 100%;
    margin: 0 auto;
    padding: 88px 24px;
}

.secao-cabecalho { text-align: center; margin-bottom: 48px; }

.secao-cabecalho h2 {
    font-size: 40px;
    letter-spacing: 0.1em;
}

.secao-cabecalho h2::after {
    content: "";
    display: block;
    width: 48px;
    height: 2px;
    background: var(--vermelho);
    margin: 16px auto 0;
}

.secao-cabecalho p {
    margin: 18px auto 0;
    max-width: 560px;
    color: var(--texto-2);
}

/* ---------- PRODUTOS ---------- */
.grid-produtos {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 24px;
}

.produto {
    background: var(--card);
    border: 1px solid var(--borda);
    border-radius: 4px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
}

.produto:hover {
    transform: translateY(-6px);
    border-color: var(--vermelho);
    box-shadow: 0 18px 40px -18px rgba(225, 6, 0, 0.55);
}

.produto-midia {
    aspect-ratio: 1 / 1;
    background: var(--preto-2);
    overflow: hidden;
}

.produto-midia img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(20%) contrast(1.05);
    transition: transform 0.4s ease, filter 0.4s ease;
}

.produto:hover .produto-midia img {
    transform: scale(1.06);
    filter: grayscale(0) contrast(1.1);
}

.produto-corpo {
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
}

.produto-corpo h3 { font-size: 22px; }

.produto-corpo p {
    margin: 0;
    color: var(--texto-2);
    font-size: 14px;
    flex: 1;
}

.preco {
    color: var(--vermelho);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
}

/* ---------- SOBRE ---------- */
.texto-largo {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
    color: var(--texto-2);
    font-size: 17px;
}

.pilares {
    list-style: none;
    margin: 48px auto 0;
    padding: 0;
    max-width: 900px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 20px;
}

.pilares li {
    border: 1px solid var(--borda);
    border-top: 2px solid var(--vermelho);
    background: var(--card);
    padding: 22px;
    text-align: center;
}

.pilares strong {
    display: block;
    font-family: var(--fonte-titulo);
    font-size: 22px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 6px;
}

.pilares span { color: var(--texto-2); font-size: 14px; }

/* ---------- CONTATO ---------- */
.secao-contato { border-top: 1px solid var(--borda); }

.contato-lista {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    justify-content: center;
    gap: 32px;
    flex-wrap: wrap;
}

.contato-lista a {
    color: var(--texto);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-size: 12px;
    font-weight: 600;
    border-bottom: 1px solid var(--vermelho-escuro);
    padding-bottom: 6px;
    transition: color 0.25s ease, border-color 0.25s ease;
}

.contato-lista a:hover { color: var(--vermelho); border-color: var(--vermelho); }

/* ---------- WHATSAPP FLUTUANTE ---------- */
.whatsapp-button {
    position: fixed;
    bottom: 22px;
    right: 22px;
    width: 54px;
    height: 54px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--vermelho);
    color: #fff;
    border-radius: 50%;
    box-shadow: 0 10px 30px -8px rgba(225, 6, 0, 0.7);
    transition: transform 0.25s ease, background-color 0.25s ease;
    z-index: 900;
}

.whatsapp-button:hover { transform: scale(1.08); background: var(--vermelho-escuro); }

/* ---------- MODAL ---------- */
.modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(4px);
    display: none;
    align-items: center;
    justify-content: center;
    padding: 24px;
    z-index: 1100;
}

.modal-overlay.aberto { display: flex; }

.modal {
    position: relative;
    width: 100%;
    max-width: 420px;
    max-height: 90vh;
    overflow-y: auto;
    background: var(--card);
    border: 1px solid var(--borda);
    border-radius: 6px;
    padding: 28px;
    text-align: center;
    animation: sobe 0.25s ease;
}

@keyframes sobe {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
}

.modal img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: 4px;
    margin-bottom: 18px;
    background: var(--preto-2);
}

.modal h3 { font-size: 26px; margin-bottom: 10px; }

.modal p { color: var(--texto-2); font-size: 14px; margin: 0 0 12px; }

.modal-preco {
    color: var(--vermelho) !important;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-size: 12px;
}

.modal-fechar {
    position: absolute;
    top: 10px;
    right: 12px;
    background: transparent;
    border: none;
    color: var(--texto-2);
    font-size: 28px;
    line-height: 1;
    cursor: pointer;
    transition: color 0.2s ease;
}

.modal-fechar:hover { color: var(--vermelho); }

/* ---------- FOOTER ---------- */
.footer {
    margin-top: auto;
    border-top: 1px solid var(--borda);
    padding: 32px 24px;
    text-align: center;
    background: var(--preto-2);
}

.footer .logo { font-size: 22px; }

.footer p { margin: 8px 0 0; color: var(--texto-2); font-size: 12px; letter-spacing: 0.1em; }

/* ---------- RESPONSIVO ---------- */
@media (max-width: 640px) {
    .navbar-inner { flex-direction: column; gap: 12px; }
    .navbar ul { gap: 18px; justify-content: center; }
    .hero { padding: 80px 20px 70px; }
    .secao { padding: 64px 20px; }
}
