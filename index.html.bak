    <div class="modal-overlay" id="modalOverlay" role="dialog" aria-modal="true" aria-labelledby="modalTitulo">
        <div class="modal">
            <button class="modal-fechar" id="modalFechar" aria-label="Fechar">&times;</button>
            <img id="modalImg" src="" alt="">
            <h3 id="modalTitulo"></h3>
            <p id="modalDescricao"></p>
            <p class="modal-preco" id="modalPreco"></p>
            <a class="btn btn-primario" id="modalWhats" href="#" target="_blank" rel="noopener noreferrer">Consultar no WhatsApp</a>
        </div>
    </div>
    <footer class="footer">
        <span class="logo">???</span>
        <p>&copy; 2026 ???. Todos os direitos reservados.</p>
    </footer>
    <script>
        // Configurações do Modal e WhatsApp
        const WHATSAPP_BASE = "https://wa.me/5511960623250";
        const overlay = document.getElementById("modalOverlay");
        const modalImg = document.getElementById("modalImg");
        const modalTitulo = document.getElementById("modalTitulo");
        const modalDescricao = document.getElementById("modalDescricao");
        const modalPreco = document.getElementById("modalPreco");
        const modalWhats = document.getElementById("modalWhats");
        const modalFechar = document.getElementById("modalFechar");
        function abrirModal(botao) {
            if (!botao || !overlay) return;
            const nome = botao.dataset.nome || "";
            if (modalImg) {
                modalImg.src = botao.dataset.img || "";
                modalImg.alt = nome;
            }
            if (modalTitulo) modalTitulo.textContent = nome;
            if (modalDescricao) modalDescricao.textContent = botao.dataset.descricao || "";
            if (modalPreco) modalPreco.textContent = botao.dataset.preco || "";
            if (modalWhats) {
                modalWhats.href = WHATSAPP_BASE + "?text=" + encodeURIComponent("Olá, gostaria de saber mais sobre: " + nome);
            }
            overlay.classList.add("aberto");
            document.body.style.overflow = "hidden";
        }
        function fecharModal() {
            if (!overlay) return;
            overlay.classList.remove("aberto");
            document.body.style.overflow = "";
        }
        // Torna o card inteiro de cada produto clicável para abrir o modal
        document.querySelectorAll(".produto").forEach(function (card) {
            card.style.cursor = "pointer"; // adiciona o cursor de mãozinha
            card.setAttribute("tabindex", "0");
            card.addEventListener("click", function () {
                const botao = card.querySelector(".saiba-mais");
                if (botao) {
                    abrirModal(botao);
                }
            });
            // Permite abrir pelo teclado (Enter ou Espaço)
            card.addEventListener("keydown", function (evento) {
                if (evento.key === "Enter" || evento.key === " ") {
                    evento.preventDefault();
                    const botao = card.querySelector(".saiba-mais");
                    if (botao) {
                        abrirModal(botao);
                    }
                }
            });
        });
        // Fechamento do modal
        if (modalFechar) {
            modalFechar.addEventListener("click", fecharModal);
        }
        if (overlay) {
            overlay.addEventListener("click", function (evento) {
                if (evento.target === overlay) fecharModal();
            });
        }
        document.addEventListener("keydown", function (evento) {
            if (evento.key === "Escape") fecharModal();
        });
        // Link do menu ativo conforme a seção visível
        const links = Array.from(document.querySelectorAll(".navbar li a"));
        const secoes = links
            .map(function (link) {
                return document.querySelector(link.getAttribute("href"));
            })
            .filter(Boolean);
        if ("IntersectionObserver" in window && secoes.length) {
            const observador = new IntersectionObserver(
                function (entradas) {
                    entradas.forEach(function (entrada) {
                        if (!entrada.isIntersecting) return;
                        links.forEach(function (link) {
                            link.classList.toggle("ativo", link.getAttribute("href") === "#" + entrada.target.id);
                        });
                    });
                },
                { rootMargin: "-45% 0px -50% 0px" }
            );
            secoes.forEach(function (secao) {
                observador.observe(secao);
            });
        }
    </script>
</body>
